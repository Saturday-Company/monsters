{
  "name": "@monsters/site",
  "version": "0.0.0",
  "description": "Monsters presentation website: a static Astro site, deployed as a Cloudflare static-assets Worker",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc -p tsconfig.json",
    "deploy:worker": "node scripts/deploy.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/doto": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@monsters/monster-kit": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@monsters/shared": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.0",
    "shiki": "4.5.0"
  }
}
