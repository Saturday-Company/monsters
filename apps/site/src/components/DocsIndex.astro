---
/* /docs/ and /it/docs/: the list of guides. The guides exist in English only. */
import { GETTING_STARTED } from '../i18n/getting-started.ts';
import { STRINGS, type Lang } from '../i18n/strings.ts';
import { PAGES } from '../i18n/pages.ts';
import Text from '../layouts/Text.astro';
import { GUIDES } from '../lib/docs.ts';
import { REPO_URL } from '../lib/feed.ts';
import { pageLdText } from '../lib/seo.ts';
import Crumbs from './Crumbs.astro';
import Tty, { type TtyLine } from './Tty.astro';
import desktop from '../../../desktop/package.json' with { type: 'json' };

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = STRINGS[lang];
const p = PAGES[lang];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const path = lang === 'it' ? '/it/docs/' : '/docs/';
const home = lang === 'it' ? '/it/' : '/';
const start = GETTING_STARTED[lang];
// Next to the Getting started card, its first three steps in the site's tty: the commands of
// step 1 as the guide prints them (the from-source route), the line `monsters start` prints
// (packages/cli/src/main.ts), then one line for each of steps 2 and 3.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const [install, first, model] = start.steps;
// The tty wraps at spaces only: an address or a key prefix stays whole (the window scrolls if it
// must), and `&& next` hangs together, so a long command breaks after `clone` or before `&&`.
const keep = (s: string) =>
  esc(s)
    .replace(/(https?:\/\/[^\s]+|sk-or-…)/g, '<span class="nb">$1</span>')
    .replace(/&amp;&amp; (.*)$/, (_, rest: string) => `&amp;&amp;\u00a0${rest.replace(/ /g, '\u00a0')}`);
const prompt = (cmd: string): TtyLine => ({ html: `<span class="p">$</span> ${keep(cmd)}` });
const step = (title: string): TtyLine => ({ html: `# ${esc(title)}`, cls: 'g' });
// The same three steps as a short numbered list in the card: the titles of the guide without the
// number it prints in front of them.
const steps = [install!, first!, model!].map((s, i) => ({
  n: String(i + 1).padStart(2, '0'),
  title: s.title.replace(/^\d+\.\s*/, ''),
}));
const ttyLines: TtyLine[] = [
  step(install!.title),
  { html: `# ${esc(install!.cmds![0]!.label)}`, cls: 'o' },
  ...install!.cmds![0]!.code.split('\n').map(prompt),
  { html: `Open ${keep('http://127.0.0.1:4747/')} in your browser.`, cls: 'o' },
  { html: ' ', cls: 'gap' },
  step(first!.title),
  { html: keep(start.ttyLines[0]), cls: 'o' },
  { html: ' ', cls: 'gap' },
  step(model!.title),
  { html: keep(start.ttyLines[1]), cls: 'o' },
  { html: '<span class="p">$</span> <span class="cursor"></span>' },
];
const ld = pageLdText({
  lang,
  site,
  path,
  title: p.docs.metaTitle,
  description: p.docs.description,
  type: 'CollectionPage',
  crumbs: [
    { name: p.crumbHome, path: home },
    { name: p.docs.crumb, path },
  ],
});
---

<Text
  t={t}
  title={p.docs.metaTitle}
  description={p.docs.description}
  path={path}
  alternates={{ en: '/docs/', it: '/it/docs/' }}
  ld={ld}
  otherHref={lang === 'it' ? '/docs/' : '/it/docs/'}
>
  <article class="doc">
    <Crumbs crumbs={[{ name: p.crumbHome, href: home }]} current={p.docs.crumb} />
    <header class="doc__head">
      <h1 class="display doc__title">{p.docs.title}</h1>
      <p class="lede">{p.docs.lede}</p>
      {p.docs.englishOnly && <p class="doc__note">{p.docs.englishOnly}</p>}
    </header>

    <ul class="cards" role="list">
      <li class="cards__lead">
        <a class="card" href={`${path}getting-started/`}>
          <span class="label card__kicker">{start.kicker}</span>
          <h2 class="card__title">{start.title}</h2>
          <span class="card__text">{start.tldr}</span>
          <ol class="card__steps" role="list">
            {
              steps.map((s) => (
                <li>
                  <span class="card__n" aria-hidden="true">
                    {s.n}
                  </span>
                  <span>{s.title}</span>
                </li>
              ))
            }
          </ol>
          <span class="card__go label">{start.open} →</span>
        </a>
        <Tty title="tty1 · monsters" meta={desktop.version} lines={ttyLines} class="cards__tty" />
      </li>
      {
        GUIDES.map((g) => (
          <li>
            <a class="card" href={`/docs/${g.slug}/`} hreflang="en" lang="en">
              <span class="label card__kicker">{g.file}</span>
              <h2 class="card__title">{g.title}</h2>
              <span class="card__text" lang={lang}>
                {p.docs.summaries[g.slug]}
              </span>
              <span class="card__go label">{p.docs.read} →</span>
            </a>
          </li>
        ))
      }
    </ul>

    <section class="doc__more" aria-labelledby="more-title">
      <h2 class="doc__h2" id="more-title">{p.docs.more}</h2>
      <ul class="points" role="list">
        {
          p.docs.moreItems.map(([name, file, text]) => (
            <li>
              <a href={`${REPO_URL}/blob/main/${file}`} rel="noopener">
                {name}
              </a>
              : {text}
            </li>
          ))
        }
      </ul>
      <p class="doc__note">
        {p.docs.source}{' '}
        <a href={`${REPO_URL}/tree/main/docs`} rel="noopener">{p.docs.sourceLink}</a>
      </p>
    </section>
  </article>
</Text>
