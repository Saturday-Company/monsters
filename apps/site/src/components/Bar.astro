---
import { type Strings } from '../i18n/strings.ts';
import { REPO_URL } from '../lib/feed.ts';
import { formatStars, LED_DIGITS } from '../lib/stars.ts';

interface Props {
  t: Strings;
  stamp: string;
  stars: number | null;
  home: string;
  /** False on any page but the home: the section links then point at the home. */
  onHome?: boolean;
  /** The same page in the other language, when it is not the other home. */
  otherHref?: string | undefined;
}
const { t, stamp, stars, home, onHome = true, otherHref } = Astro.props;
const at = onHome ? '' : home;
const docsHref = t.lang === 'it' ? '/it/docs/' : '/docs/';
const compareHref = t.lang === 'it' ? '/it/compare/' : '/compare/';
const label = `, ${stars === null ? t.nav.starsUnknown : `${t.nav.stars} ${stars}`}`;
---

<header class="bar">
  <div class="bar__in">
    <a class="word" href={home} aria-label="Monsters">monsters</a>
    <span class="stamp" title="Part number">{stamp}</span>
    <nav class="bar__nav label" aria-label="Sections">
      <a href={`${at}#squad`}>{t.nav.squad}</a>
      <a href={`${at}#generator`}>{t.nav.generator}</a>
      <a href={`${at}#specs`}>{t.nav.specs}</a>
      <a href={`${at}#download`}>{t.nav.download}</a>
      <a href={`${at}#faq`}>{t.nav.faq}</a>
      <a class="bar__more" href={docsHref}>{t.nav.docs}</a>
      <a class="bar__more" href={compareHref}>{t.nav.compare}</a>
    </nav>
    {
      onHome && (
        <button type="button" class="bar__cmd label" data-pal-open aria-keyshortcuts="/ Control+K">
          <kbd aria-hidden="true">/</kbd>
          <span>{t.palette.open}</span>
        </button>
      )
    }
    <a
      class="bar__lang label"
      href={otherHref ?? t.nav.otherHref}
      hreflang={t.lang === 'en' ? 'it' : 'en'}
      lang={t.lang === 'en' ? 'it' : 'en'}
      aria-label={t.nav.otherLabel}>{t.nav.other}</a
    >
    <a class="star" href={REPO_URL} rel="noopener" data-stars-link>
      <span class="led" aria-hidden="true">
        <span class="led__ghost">{'8'.repeat(LED_DIGITS)}</span>
        <span class="led__val" data-stars>{formatStars(stars)}</span>
      </span>
      <span class="star__key label">
        <span class="star__glyph" aria-hidden="true">★</span><span class="star__text">{t.nav.star}</span><span class="sr-only" data-stars-sr
          >{label}</span
        >
      </span>
    </a>
  </div>
</header>
