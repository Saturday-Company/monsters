{
  "name": "@monsters/desktop",
  "version": "0.1.0-alpha.18",
  "description": "Monsters desktop app (Electron): the core in a utility process, the web UI in a hardened window",
  "license": "Apache-2.0",
  "author": "Giulio Banchini and Saturday Company",
  "homepage": "https://monsters.saturdaycompany.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saturday-Company/monsters.git",
    "directory": "apps/desktop"
  },
  "bugs": {
    "url": "https://github.com/Saturday-Company/monsters/issues"
  },
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "pnpm -w run build:core && node scripts/build.ts && node scripts/launch.ts",
    "start": "node scripts/launch.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "node scripts/build.ts && node scripts/e2e.ts",
    "screenshots": "node scripts/build.ts && node scripts/e2e.ts --screenshots",
    "icons": "node scripts/make-icons.ts"
  },
  "dependencies": {
    "@monsters/monster-kit": "workspace:*",
    "@monsters/remote": "workspace:*",
    "@monsters/shared": "workspace:*",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/doto": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@monsters/core": "workspace:*",
    "@playwright/test": "1.64.0",
    "electron": "44.7.1",
    "electron-builder": "26.17.0",
    "yaml": "2.9.1"
  }
}
