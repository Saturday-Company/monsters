<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements of Monsters (D-046), for the app and its helpers (also the
  utility processes of the core and of the keychain calls; RunAsNode is off, S-M8).
  Only allow-jit: V8 maps its JIT code with MAP_JIT. Not given because not needed:
  allow-unsigned-executable-memory (old Electron versions), disable-library-validation (the
  native modules in Resources/core are signed with the same Team ID as the app).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
