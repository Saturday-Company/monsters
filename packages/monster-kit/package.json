{
  "name": "@monsters/monster-kit",
  "version": "0.0.0",
  "description": "Parametric SVG monster kit: genome schema, parts, OKLCH palettes and renderer.",
  "license": "Apache-2.0",
  "author": "Giulio Banchini and Saturday Company",
  "homepage": "https://monsters.saturdaycompany.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saturday-Company/monsters.git",
    "directory": "packages/monster-kit"
  },
  "bugs": {
    "url": "https://github.com/Saturday-Company/monsters/issues"
  },
  "private": true,
  "type": "module",
