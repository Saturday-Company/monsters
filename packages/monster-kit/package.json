        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "concept": "node scripts/concept.ts",
    "team-sheet": "node scripts/team.ts",
    "dots-sheet": "node scripts/dots-sheet.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "engines": {
    "node": ">=24"
  }
