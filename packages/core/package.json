{
  "name": "@monsters/core",
  "version": "0.0.0",
  "description": "Monsters core: event log, auth, kill switch and local server",
  "license": "Apache-2.0",
  "author": "Giulio Banchini and Saturday Company",
  "homepage": "https://monsters.saturdaycompany.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saturday-Company/monsters.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Saturday-Company/monsters/issues"
  },
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "monsters-dist": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "node eval/run.ts",
    "eval:decisions": "node eval/decisions/run.ts",
    "eval:instinct": "node eval/instinct/run.ts",
    "eval:egress": "node eval/egress/replay.ts",
    "eval:awareness": "node eval/awareness/run.ts",
    "eval:projects": "node eval/projects/run.ts",
    "eval:projects-measure": "node eval/projects/measure.ts",
    "eval:context": "node eval/context/run.ts",
    "eval:compaction": "node eval/compaction/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@monsters/db": "workspace:*",
    "@monsters/monster-kit": "workspace:*",
    "@monsters/providers": "workspace:*",
    "@monsters/shared": "workspace:*",
    "@monsters/tools": "workspace:*",
    "@monsters/vault": "workspace:*",
    "@napi-rs/keyring": "2.1.0",
    "@node-rs/argon2": "2.2.2",
    "ai": "7.0.137",
    "croner": "10.0.1",
    "grammy": "1.46.0",
    "hono": "4.13.13",
    "tldts": "7.4.16",
    "unpdf": "1.8.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
