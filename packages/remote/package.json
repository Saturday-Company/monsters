{
  "name": "@monsters/remote",
  "version": "0.0.0",
  "description": "Client mode of Monsters: SSH tunnel to a core running on another machine",
  "license": "Apache-2.0",
  "author": "Giulio Banchini and Saturday Company",
  "homepage": "https://getmonsters.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saturday-Company/monsters.git",
    "directory": "packages/remote"
  },
  "bugs": {
    "url": "https://github.com/Saturday-Company/monsters/issues"
  },
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "monsters-dist": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    },
    "./testing": {
      "monsters-dist": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "default": "./src/testing/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@monsters/shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@monsters/core": "workspace:*",
    "@types/ws": "8.18.2",
    "ws": "8.22.0"
  }
}
